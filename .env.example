# Copy to .env and fill in. .env is gitignored — never commit real values.
# Load before running, e.g.:  set -a; . ./.env; set +a

# Broadcastify premium membership login, used for the audio.broadcastify.com
# "Static URL" streams (https://audio.broadcastify.com/<FEEDID>.mp3).
BROADCASTIFY_USERNAME=
BROADCASTIFY_PASSWORD=

# Ingest tokens for the Cloudflare Worker feeds (wrangler secret INGEST_TOKEN).
SCANNER_FEED_TOKEN_VANCOUVER_ISLAND=
SCANNER_FEED_TOKEN_INTERIOR=
